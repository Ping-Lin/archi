{
  "schemaVersion": "archi/analysis-v2alpha1",
  "simulation": true,
  "name": "Commerce · multi-service evidence",
  "sources": [
    {
      "service": "storefront",
      "files": [
        "examples/system/src/Clients.java"
      ],
      "clientTypes": [
        "RemoteClient"
      ]
    },
    {
      "service": "orders",
      "files": [
        "examples/system/src/Clients.java"
      ],
      "clientTypes": [
        "RemoteClient"
      ]
    },
    {
      "service": "inventory",
      "files": [
        "examples/system/src/Clients.java",
        "examples/system/src/OptionalClients.java"
      ],
      "clientTypes": [
        "RemoteClient"
      ]
    }
  ],
  "helm": {
    "chart": "examples/system/chart",
    "version": "v3.17.3",
    "kubeVersion": "1.31.0",
    "apiVersions": []
  },
  "environments": [
    {
      "id": "qa",
      "namespace": "commerce-qa",
      "cluster": "synthetic-qa",
      "release": "commerce-qa",
      "values": [
        "examples/system/environments/qa.yaml"
      ],
      "targets": [
        {
          "id": "orders",
          "url": "http://orders.commerce-qa.svc.cluster.local:8080",
          "kind": "service"
        },
        {
          "id": "inventory",
          "url": "http://inventory.commerce-qa.svc.cluster.local:8080",
          "kind": "service"
        },
        {
          "id": "warehouse",
          "url": "https://warehouse.example.invalid",
          "kind": "external"
        },
        {
          "id": "audit",
          "url": "https://audit.example.invalid",
          "kind": "external"
        }
      ],
      "callers": [
        {
          "service": "storefront",
          "profiles": [
            "qa"
          ],
          "propertyFiles": [],
          "propertiesComplete": true,
          "observations": null
        },
        {
          "service": "orders",
          "profiles": [
            "qa"
          ],
          "propertyFiles": [],
          "propertiesComplete": true,
          "observations": "examples/system/environments/orders-observations.json"
        },
        {
          "service": "inventory",
          "profiles": [
            "qa"
          ],
          "propertyFiles": [],
          "propertiesComplete": true,
          "observations": null
        }
      ]
    },
    {
      "id": "production",
      "namespace": "commerce-production",
      "cluster": "synthetic-production",
      "release": "commerce-production",

      ],
      "targets": [
        {
          "id": "orders",
          "url": "http://orders.commerce-production.svc.cluster.local:8080",
          "kind": "service"
        },
        {
          "id": "inventory",
          "url": "http://inventory.commerce-production.svc.cluster.local:8080",
          "kind": "service"
        },
        {
          "id": "warehouse",
          "url": "https://warehouse.example.invalid",
          "kind": "external"
        },
        {
          "id": "audit",
          "url": "https://audit.example.invalid",

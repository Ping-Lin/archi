{
  "apiVersion": "archi/v1alpha1",
  "system": {
    "id": "meridian",
    "name": "Meridian Commerce",
    "description": "A fictional multi-project architecture and deployment sandbox",
    "simulation": true
  },
  "projects": [
    {
      "id": "commerce",
      "name": "Commerce",
      "owner": "Experience team",
      "repo": "https://example.com/repos/commerce",
      "description": "Customer entry and order lifecycle"
    },
    {
      "id": "fulfillment",
      "name": "Fulfillment",
      "owner": "Operations team",
      "repo": "https://example.com/repos/fulfillment",
      "description": "Inventory allocation and shipment"
    },
    {
      "id": "platform",
      "name": "Platform",
      "owner": "Platform team",
      "repo": "https://example.com/repos/platform",
      "description": "Identity, payment adapters and notifications"
    }
  ],
  "services": [
    {
      "id": "gateway",
      "name": "API Gateway",
      "project": "commerce",
      "layer": "edge",
      "description": "Routes incoming customer requests",
      "port": 8100,
      "repoPath": "services/gateway"
    },
    {
      "id": "orders",
      "name": "Order Service",
      "project": "commerce",
      "layer": "domain",
      "description": "Coordinates checkout and fulfillment",
      "port": 8101,
      "repoPath": "services/orders"
    },
    {
      "id": "catalog",
      "name": "Catalog Service",
      "project": "commerce",
      "layer": "domain",
      "description": "Provides product metadata",
      "port": 8102,
      "repoPath": "services/catalog"
    },
    {
      "id": "inventory",
      "name": "Inventory Service",
      "project": "fulfillment",
      "layer": "domain",
      "description": "Reserves available stock",
      "port": 8103,
      "repoPath": "services/inventory"
    },
    {
      "id": "shipping",
      "name": "Shipping Service",
      "project": "fulfillment",
      "layer": "integration",
      "description": "Arranges shipment",
      "port": 8104,
      "repoPath": "services/shipping"
    },
    {
      "id": "identity",
      "name": "Identity Service",
      "project": "platform",
      "layer": "domain",
      "description": "Checks customer identity",
      "port": 8105,
      "repoPath": "services/identity"
    },
    {
      "id": "payments",
      "name": "Payment Adapter",
      "project": "platform",
      "layer": "integration",
      "description": "Simulates payment authorization",
      "port": 8106,
      "repoPath": "services/payments"
    },
    {
      "id": "notifications",
      "name": "Notification Worker",
      "project": "platform",
      "layer": "integration",
      "description": "Simulates an asynchronous notification consumer",
      "port": 8107,
      "repoPath": "services/notifications"
    }
  ],
  "dependencies": [
    {
      "id": "dep-1",
      "source": "gateway",
      "target": "identity",
      "protocol": "HTTP",
      "label": "Authenticate",
      "evidence": "design-spec"
    },
    {
      "id": "dep-2",
      "source": "gateway",
      "target": "orders",
      "protocol": "HTTP",
      "label": "Checkout",
      "evidence": "design-spec"
    },
    {
      "id": "dep-3",
      "source": "gateway",
      "target": "catalog",
      "protocol": "HTTP",
      "label": "Browse",
      "evidence": "design-spec"
    },
    {
      "id": "dep-4",
      "source": "orders",
      "target": "inventory",
      "protocol": "gRPC",
      "label": "Reserve stock",
      "evidence": "design-spec"
    },
    {
      "id": "dep-5",
      "source": "orders",
      "target": "payments",
      "protocol": "gRPC",
      "label": "Authorize payment",
      "evidence": "design-spec"
    },
    {
      "id": "dep-6",
      "source": "orders",
      "target": "shipping",
      "protocol": "HTTP",
      "label": "Create shipment",
      "evidence": "design-spec"
    },
    {
      "id": "dep-7",
      "source": "shipping",
      "target": "inventory",
      "protocol": "gRPC",
      "label": "Confirm allocation",
      "evidence": "design-spec"
    },
    {
      "id": "dep-8",
      "source": "orders",
      "target": "notifications",
      "protocol": "AMQP",
      "label": "Order placed",
      "evidence": "design-spec"
    }
  ],
  "contexts": [
    {
      "id": "dev-local",
      "name": "Development",
      "environment": "dev",
      "cluster": "kind-local",
      "namespace": "archi-dev"
    },
    {
      "id": "prod-east",
      "name": "Production · East",
      "environment": "prod",
      "cluster": "tw-east",
      "namespace": "archi-prod"
    },
    {
      "id": "prod-west",
      "name": "Production · West",
      "environment": "prod",
      "cluster": "tw-west",
      "namespace": "archi-prod"
    }
  ],

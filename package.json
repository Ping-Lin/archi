{
  "name": "archi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/archi.mjs serve",
    "demo": "node scripts/archi.mjs demo",
    "generate": "node scripts/archi.mjs generate",
    "validate": "node scripts/archi.mjs validate",
    "check": "node scripts/archi.mjs check",
    "check:helm": "node scripts/archi.mjs helm",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run test:analysis && npm run test:skill",
    "test:skill": "node tests/skill-scenario.mjs",
    "analyze": "node scripts/analyze.mjs",
    "test:analysis": "node --test tests/analysis/*.test.mjs",
    "check:analysis": "node scripts/analyze.mjs --oracle tests/fixtures/analysis-oracle.json",
    "analyze:logistics": "node scripts/analyze.mjs --config examples/logistics/archi.config.json --oracle tests/fixtures/logistics-oracle.json",
    "analyze:system": "node scripts/analyze.mjs --config examples/system/archi.config.json --oracle tests/fixtures/system-oracle.json",
    "fixture:cross-repo": "node scripts/cross-repo-fixture.mjs",
    "traffic": "node scripts/traffic.mjs"
  },
  "overrides": {
    "lodash": "4.18.1",
    "lodash-es": "4.18.1"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "java-parser": "3.0.1",
    "yaml": "2.9.1"
  }
}
